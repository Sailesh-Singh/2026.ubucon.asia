---
import { sponsors } from "../data/sponsors";
import { useTranslations, defaultLocale } from "../i18n/ui";
import SponsorCard from "../components/SponsorCard.tsx";

const locale = Astro.props.locale || defaultLocale;
const t = useTranslations(locale) as (key: string) => string;
---

<style>
  /* Logo area scales with the tier's grid span so bigger tiers get taller cards */
  .sponsor-grid :global(.col-5 .sponsor-card) {
    min-height: 200px;
  }
  .sponsor-grid :global(.col-3 .sponsor-card) {
    min-height: 150px;
  }
  .sponsor-grid :global(.col-2 .sponsor-card) {
    min-height: 120px;
  }
  .sponsor-grid :global(.col-1 .sponsor-card) {
    min-height: 100px;
  }
</style>

<div class="p-section">
  <div class="row">
    <h2>Our Sponsors</h2>
  </div>
  {
    sponsors.map((level) => (
      <div class="p-section">
        <div class="row">
          <hr class="p-rule" />
        </div>
        <div class="row">
          <div class="col-3">
            <h3>{level.sponsorLevelName}</h3>
          </div>
          <div class="col-9">
            <div class="row sponsor-grid">
              {level.list.map((item) => (
                <div
                  class={`col-${level.sizeOnLargeScreen} col-medium-${level.sizeOnMediumScreen} col-small-${level.sizeOnSmallScreen}`}
                >
                  <SponsorCard
                    name={item.nameKey ? t(item.nameKey) : item.name ?? ""}
                    logoImageSrc={item.logoUrl}
                    description={item.descriptionKey ? t(item.descriptionKey) : item.description ?? ""}
                    url={item.url}
                    level={level.sponsorLevelName}
                    tierColor={level.tierColor}
                    partnerTag={item?.partnerTag}
                    showPopup={level.showPopup}
                    client:only="react"
                  />
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    ))}
</div>
